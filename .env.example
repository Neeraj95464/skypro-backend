# Copy to .env and fill in real values. Never commit .env.

# Database (used by the app; docker-compose overrides DB_URL to point at the mysql service)
DB_URL=jdbc:mysql://localhost:3306/schoolManagement
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT signing secret (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# SMTP account used for e-mail notifications (e.g. a Gmail app password)
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=change-me
